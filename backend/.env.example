NODE_ENV=development
TZ=America/Lima
PORT=8080
HOST=0.0.0.0
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=info

DB_HOST=localhost
DB_PORT=5432
DB_NAME=gestiondecapacitacion
DB_USER=gestiondecapacitacion
DB_PASSWORD=gestiondecapacitacion
DB_SSL=false
DB_TIMEZONE=America/Lima

REDIS_URL=redis://:gestiondecapacitacion@localhost:6379

# Marcadores: el servidor no arranca con ellos. `npm run env:init` los reemplaza.
JWT_SECRET=CAMBIA_ESTE_SECRETO_JWT_DE_32_CARACTERES_MINIMO
JWT_EXPIRES_IN=1d

ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@gestioncapa.local
ADMIN_PASSWORD=CAMBIA_ESTA_CLAVE_DE_12_CARACTERES

# Firma del QR de asistencia (32+ caracteres). `npm run env:init` lo reemplaza.
QR_SECRET=CAMBIA_ESTE_SECRETO_QR_DE_32_CARACTERES_MINIMO
