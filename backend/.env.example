NODE_ENV=development
TZ=America/Lima
PORT=8080
HOST=0.0.0.0
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=info
# Organización del catálogo público y solicitudes autenticadas por usuario/minuto.
limitePeticiones=300

# HU-43: activar solo con autorización del CPPP y un padrón vigente.
inscripcionExternaHabilitada=false

DB_HOST=localhost
DB_PORT=5432
DB_NAME=gestiondecapacitacion
DB_USER=gestiondecapacitacion
DB_PASSWORD=gestiondecapacitacion
DB_SSL=false
DB_TIMEZONE=America/Lima

REDIS_URL=redis://:gestiondecapacitacion@localhost:6379

# Marcadores: el servidor no arranca con ellos. `npm run env:init` los reemplaza.
JWT_SECRET=CAMBIA_ESTE_SECRETO_JWT_DE_32_CARACTERES_MINIMO
JWT_EXPIRES_IN=1d

ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@gestioncapa.local
ADMIN_PASSWORD=CAMBIA_ESTA_CLAVE_DE_12_CARACTERES

# Firma del QR de asistencia (32+ caracteres). `npm run env:init` lo reemplaza.
QR_SECRET=CAMBIA_ESTE_SECRETO_QR_DE_32_CARACTERES_MINIMO

# Reuniones: habilitar después de preparar infraestructura/jitsi
jitsiHabilitado=false
# jitsiDominio=meet.empresa.pe
# jitsiAplicacion=gestioncapa
# jitsiSecreto se genera con infraestructura/jitsi/preparar.mjs
# jitsiEventosSecreto también lo genera preparar.mjs: autentica el webhook de Prosody
# (event_sync) para la asistencia virtual y debe ser distinto de los demás secretos.

# HU-54: las altas y la conciliación de Izipay tienen controles separados.
pagosEntorno=sandbox
izipayHabilitado=false
izipayConciliacionHabilitada=false
culqiHabilitado=false
# T-25: ofrece nuevos destinos bancarios solo tras configurar una cuenta institucional.
# Al deshabilitar, se conservan declaraciones y destinos ofrecidos anteriormente.
transferenciaHabilitada=false
# transferenciaBanco=EJEMPLO_BANCO_INSTITUCIONAL
# transferenciaTitular=EJEMPLO_TITULAR_INSTITUCIONAL
# transferenciaCuenta=EJEMPLO_NUMERO_DE_CUENTA
# transferenciaCci=EJEMPLO_CCI_DE_20_DIGITOS
# Origen HTTPS donde los proveedores enviarán notificaciones; sin ruta.
# pagosUrlPublica=https://cursos.example.org
# Izipay Web Core: reemplazar los marcadores por credenciales propias del sandbox.
# izipayCodigoComercio=EJEMPLO_COMERCIO
# izipayClavePublica=EJEMPLO_CLAVE_API_SANDBOX
# izipayClaveHash=EJEMPLO_CLAVE_HASH_SANDBOX_DE_32_CARACTERES
# izipayRsaPublica=EJEMPLO_LLAVE_RSA_PUBLICA_DEL_COMERCIO
# Tasas de prueba en puntos base. Configura solo instrumentos habilitados por Izipay.
# El 0 explícito significa que el CPPP asume la comisión. Ausente oculta el instrumento.
# izipayComisionTarjeta=350
# izipayComisionYape=350
# Culqi histórico: conservar llaves para conciliación/notificaciones de operaciones previas.
# culqiClavePublica=pk_test_EJEMPLO_REEMPLAZAR
# culqiClaveSecreta=sk_test_EJEMPLO_REEMPLAZAR
# Los ejemplos de pagos y rechazos viven en backend/test; no son cobros reales.

# HU-32: política elegida por CPPP; meses calendario desde revisión o subida pendiente.
voucherRetencionMeses=3
# SMTP deshabilitado hasta configurar una cuenta institucional. TLS obligatorio.
correoHabilitado=false
# Origen HTTPS de la aplicación. Si se omite, se usa FRONTEND_URL.
# correoOrigenPublico=https://aula.example.org
# HU-51: origen HTTPS del catálogo para enlaces /c/:id e imágenes de WhatsApp. Si se omite, se usa FRONTEND_URL.
# catalogoOrigenPublico=https://capacitaciones.example.org
correoPuerto=587
correoSeguro=false
correoPlazoEnvioMs=60000
# correoServidor=smtp.example.org
# correoUsuario=EJEMPLO_USUARIO_SMTP
# correoClave=EJEMPLO_CLAVE_SMTP
# correoRemitente=pagos@example.org
# Solo pruebas locales con NODE_ENV=test y host localhost/127.0.0.1:
# correoSinTlsParaPruebas=true
