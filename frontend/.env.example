# URL base de la API (Vite y el servidor Express redirigen /api al backend)
VITE_API_URL=/api

# Backend al que apuntan Vite y el servidor Express que sirve dist/
VITE_BACKEND_URL=http://localhost:8080

# true = usa datos simulados (MSW) mientras el backend no tenga todos los endpoints
VITE_USE_MOCKS=true

# Puerto del servidor Express que sirve dist/ en produccion
PORT=3000
