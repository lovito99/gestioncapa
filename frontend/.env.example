# URL base de la API (Vite y el servidor Express redirigen /api al backend)
VITE_API_URL=/api

# Backend al que apuntan Vite y el servidor Express que sirve dist/
VITE_BACKEND_URL=http://localhost:8080

# Origen HTTPS de los enlaces cortos de cursos. Configurar al compilar y al iniciar Express.
# VITE_ORIGEN_PUBLICO=https://capacitaciones.example.org

# false = usa el backend real; true = datos simulados (MSW), como `npm run dev:demo`
VITE_USE_MOCKS=false

# Puerto del servidor Express que sirve dist/ en produccion
PORT=3000
